# Variables of the database backup service. Copy the ones you need into docker/.env
# (the file passed with --env-file to docker compose). See docs/db-backups.md.

# --- Database user used by the backup service (created by scripts/create-backup-db-user.sh) ---
BACKUP_DB_NAME=bbdd                 # same value as MYSQL_DATABASE in db/.env
BACKUP_DB_USER=backup
BACKUP_DB_PASSWORD=change-me-long-random   # NOT the root password

# --- Schedule ---
BACKUP_DUMP_HOUR=4                  # nightly full dump at 04:00 (Europe/Madrid)
BACKUP_DUMP_MINUTE=0
BACKUP_BINLOG_SHIP_HOURS=6          # closed binlogs are archived and sent every N hours

# --- Local retention on the primary ---
BACKUP_LOCAL_KEEP_DUMPS=2           # newest dumps kept (undelivered ones are always kept, up to 7)
BACKUP_LOCAL_BINLOG_DAYS=7

# --- Secondary server (leave BACKUP_REMOTE_HOST empty to keep backups local only) ---
BACKUP_REMOTE_HOST=booking-api.ddns.net
BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_USER=dbbackup
BACKUP_REMOTE_PATH=/                # root of the forced rrsync directory on the secondary
# PUBLIC age key (age1...): backups are encrypted to it before leaving the primary.
# The matching private key must be stored OFFLINE, never on either server.
BACKUP_AGE_RECIPIENT=

# --- Uptime Kuma "Push" monitor URL (Kuma on the secondary), e.g. https://kuma.example/api/push/AbCdEf ---
BACKUP_KUMA_PUSH_URL=

# --- Scratch database used by scripts/restore.sh (never exposed, destroyed after each restore) ---
RESTORE_DB_ROOT_PASSWORD=change-me-too
